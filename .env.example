# Copy this file to .env for local development. Never commit .env.
DJANGO_DEBUG=True
# DJANGO_SECRET_KEY=generate-a-long-random-string-for-production
# DJANGO_ALLOWED_HOSTS=yourapp.onrender.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourapp.onrender.com
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Public https:// address (no path). Required when DJANGO_DEBUG is off: reminder links point here.
# SITE_URL=https://yourapp.onrender.com
# PRODUCT_NAME=Clinic Records
# Public "Register your clinic" page: off by default. Demo sites only.
# ALLOW_CLINIC_SIGNUP=True
# Behind Render / Railway / Heroku / nginx: use the real visitor IP for the audit log and sign-in lockout.
# DJANGO_USE_X_FORWARDED_FOR=True
# DJANGO_TRUSTED_PROXY_COUNT=1
# Shared cache for the sign-in lockout when running more than one server process:
# "db" (then run: python manage.py createcachetable) or a redis:// URL.
# DJANGO_CACHE_URL=db
